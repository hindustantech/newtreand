# MongoDB connection string (Atlas or local).
# Example Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/satrang
# Example local:  mongodb://127.0.0.1:27017/satrang
MONGODB_URI=

# Secret used to sign JWT tokens (any long random string).
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full callback URL registered in Google Cloud Console (must match exactly).
# Local dev example: http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Cloudinary (for playlist artwork uploads). Dashboard -> Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=